<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>SmarterMail.Net</PackageId>
    <Version>2.1.6</Version>
    <PackageReleaseNotes>Notes: add GetNotesInSourceAsync for GET /api/v1/notes/notes/{owner}/{sourceId}/ and bind /api/v1/notes/sources sharedLists into NoteSourceInfo. Enables MyPortway notes source resolution and per-source listing.</PackageReleaseNotes>
    <Authors>Rui Pereira</Authors>
    <Description>A cross-platform .NET SDK that provides a strongly typed wrapper around the SmarterMail HTTP API.</Description>
    <PackageTags>smartermail;email;api;sdk</PackageTags>
    <PackageReadmeFile></PackageReadmeFile>
    <RepositoryUrl>https://github.com/RuiAAPereira/smartermail-net</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer" Version="3.0.303" />
    <PackageReference Update="Roslynator.Analyzers" Version="5.0.1" />
  </ItemGroup>
</Project>

